@model IEnumerable<BillPaymentSystem.Models.Fatura>

@{
    ViewData["Title"] = "Admin Fatura Paneli";
}

<div class="container mt-4">
    <h2 class="mb-4">Admin Fatura Yönetim Paneli</h2>

    <table class="table table-hover table-striped border">
        <thead class="table-dark">
            <tr>
                <th>Fatura No</th>
                <th>Abone No</th>
                <th>Müşteri Adı</th>
                <th>Tür</th>
                <th>Tarih</th>
                <th>Tutar</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fatura in Model)
            {
                <tr>
                    <td>@fatura.FaturaNo</td>
                    <td>@fatura.AboneNo</td>
                    <td>@fatura.Name</td>
                    <td>@fatura.FaturaType</td>
                    <td>@fatura.Tarih.ToShortDateString()</td>
                    <td>@fatura.Tutar.ToString("C2")</td>
                    <td>
                        <span class="badge @(fatura.Durum ? "bg-success" : "bg-danger")">
                            @(fatura.Durum ? "Ödendi" : "Ödenmedi")
                        </span>
                    </td>
                    <td>
                        <form asp-action="AdminPanel" method="post" onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
                            <input type="hidden" name="FaturaNo" value="@fatura.FaturaNo" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>